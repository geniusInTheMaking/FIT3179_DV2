
{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 800,
    "height": 600,
    "background": null,
    "padding": {
      "left": 60,
      "right": 0,
      "top": 0,
      "bottom": 0
    },
    "projection": {
      "type": "mercator"
    },
    "layer": [
      {
        "data": {
          "url": "data/nsw_lga.json",
          "format": {
            "type": "topojson",
            "feature": "LGA_2025_AUST_GDA94"
          }
        },
        "transform": [
          {
            "filter": "datum.properties.STE_NAME21 == 'New South Wales'"
          }
        ],
        "mark": {
          "type": "geoshape",
          "fill": "#f3f3f3",
          "stroke": "black",
          "strokeWidth": 0.6
        }
      },
      {
        "data": {
          "url": "data/nsw_library_visit_dots.csv",
          "format": {
            "type": "csv"
          }
        },
        "mark": {
          "type": "circle",
          "size": 18,
          "opacity": 0.55,
          "color": "#3274a1",
          "stroke": "white",
          "strokeWidth": 0.5
        },
        "encoding": {
          "longitude": {
            "field": "Longitude",
            "type": "quantitative"
          },
          "latitude": {
            "field": "Latitude",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "Council",
              "type": "nominal",
              "title": "Council"
            },
            {
              "field": "CouncilTotalVisits",
              "type": "quantitative",
              "title": "Total visits",
              "format": ","
            },
            {
              "field": "DotVisits",
              "type": "nominal",
              "title": "Each dot"
            }
          ]
        }
      },
      {
        "data": {
          "url": "data/nsw_lga.json",
          "format": {
            "type": "topojson",
            "feature": "LGA_2025_AUST_GDA94"
          }
        },
        "transform": [
          {
            "filter": "datum.properties.STE_NAME21 == 'New South Wales'"
          }
        ],
        "mark": {
          "type": "geoshape",
          "fill": "transparent",
          "stroke": "transparent",
          "cursor": "pointer"
        }
      },
      {
        "data": {
          "name": "selectedBoundary",
          "values": []
        },
        "mark": {
          "type": "geoshape",
          "fill": "transparent",
          "stroke": "#d17a35",
          "strokeWidth": 2.8
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "fontSize": 13,
          "font": "Helvetica Neue",
          "color": "#3f3b38"
        },
        "encoding": {
          "x": {
            "value": 20
          },
          "y": {
            "value": 580
          },
          "text": {
            "value": "●  1 dot = 10,000 physical visits to public libraries (2024–25)"
          }
        }
      }
    ],
    "config": {
      "view": {
        "stroke": null
      }
    }
  }
  